    def __init__(self, options, log, progress_reporter):
        self.issue_date = datetime.now()
        self.publication_title = self.title
        requested_edition = os.environ.get("NEWS_EPUB_EDITION", "").strip().title()
        if requested_edition in {"Morning", "Evening", "Night"}:
            self.issue_name = requested_edition
        elif self.issue_date.hour < 12:
            self.issue_name = "Morning"
        elif self.issue_date.hour < 21:
            self.issue_name = "Evening"
        else:
            self.issue_name = "Night"
        self.title = self.issue_date.strftime(
            f"{self.publication_title} — %A, %d %B %Y — {self.issue_name} Edition"
        )
        super().__init__(options, log, progress_reporter)

    def publication_date(self):
        return self.issue_date

    def get_masthead_title(self):
        return f"{self.publication_title} — {self.issue_name} Edition"

    def default_cover(self, cover_file):
        try:
            from calibre.ebooks.covers import cprefs, create_cover, override_prefs

            date_line = self.issue_date.strftime("%A, %d %B %Y")
            preferences = override_prefs(
                cprefs,
                override_color_theme="Silver",
                override_style="Half and Half",
            )
            cover_file.write(
                create_cover(
                    self.publication_title,
                    [f"{self.issue_name.upper()} EDITION", date_line],
                    prefs=preferences,
                )
            )
            cover_file.flush()
        except Exception:
            self.log.exception("Cover generation failed")
            raise
        return True

    def parse_feeds(self):
        original_feeds = self.feeds
        original_age = self.oldest_article
        specifications = [entry for _group_name, entries in self.feed_groups for entry in entries]
        selected = specifications[:self.test[0]] if self.test else specifications
        parsed = []
        try:
            for source, section, url, days in selected:
                self.feeds = [(f"{source} — {section}", url)]
                self.oldest_article = days
                parsed.extend(super().parse_feeds())
        finally:
            self.feeds = original_feeds
            self.oldest_article = original_age

        article_count = sum(len(feed) for feed in parsed)
        minimum_articles = 1 if self.test else self.min_issue_articles
        self.log.info(f"Parsed {article_count} articles from {len(parsed)} non-empty feed results")
        if article_count < minimum_articles:
            raise RuntimeError(
                f"Issue contains {article_count} articles; minimum required is {minimum_articles}"
            )
        return parsed

    @staticmethod
    def url_for_log(url):
        value = (url or "").strip()
        split = urlsplit(value)
        if split.scheme and split.hostname:
            host = split.hostname
            if ":" in host and not host.startswith("["):
                host = f"[{host}]"
            if split.port:
                host = f"{host}:{split.port}"
            return f"{split.scheme}://{host}{split.path or '/'}"
        return split.path or "<unknown-url>"

    @staticmethod
    def url_has_unsafe_network_target(url):
        split = urlsplit((url or "").strip())
        if not split.scheme and not split.netloc:
            return False
        if split.scheme.lower() not in {"http", "https"} or not split.hostname:
            return True
        if split.username or split.password:
            return True
        hostname = split.hostname.rstrip(".").lower()
        if hostname == "localhost" or hostname.endswith(".localhost"):
            return True
        try:
            address = ipaddress.ip_address(hostname)
        except ValueError:
            return False
        return not address.is_global

    def get_article_url(self, article):
        url = super().get_article_url(article)
        if not url:
            return None
        if "abcnews.com/video/" in url or "cbsnews.com/video/" in url:
            return None
        if self.url_has_unsafe_network_target(url):
            self.log.warning(
                "Rejected article URL with a local, private or unsafe target: "
                f"{self.url_for_log(url)}"
            )
            return None
        return url

    @classmethod
    def image_source_is_usable(cls, source):
        if not source:
            return False
        source = source.strip()
        lowered = source.lower()
        if lowered.startswith(("data:", "blob:", "javascript:", "about:", "file:", "#")):
            return False
        split = urlsplit(source)
        if split.scheme and split.scheme.lower() not in {"http", "https"}:
            return False
        if cls.url_has_unsafe_network_target(source):
            return False
        rejected = ("1x1", "spacer", "transparent", "tracking", "pixel.gif", "clear.gif")
        return not any(value in lowered for value in rejected)

    @classmethod
    def best_srcset_source(cls, srcset):
        candidates = []
        for position, item in enumerate((srcset or "").split(",")):
            parts = item.strip().rsplit(None, 1)
            source = parts[0].strip() if parts else ""
            if not cls.image_source_is_usable(source):
                continue

            score = (0, position + 1)
            if len(parts) == 2:
                descriptor = parts[1].lower()
                try:
                    if descriptor.endswith("w"):
                        width = int(float(descriptor[:-1]))
                        if width >= cls.source_image_target_width:
                            score = (3, -width)
                        else:
                            score = (2, width)
                    elif descriptor.endswith("x"):
                        density = float(descriptor[:-1])
                        score = (1, min(density, 2.0))
                except ValueError:
                    pass
            candidates.append((score, source))
        return max(candidates, default=((0, 0), ""))[1]

    hero_meta_names = (
        "og:image:secure_url",
        "og:image:url",
        "og:image",
        "twitter:image:src",
        "twitter:image",
    )
    hero_rejected_tokens = (
        "logo", "avatar", "author", "profile", "icon", "favicon",
        "sprite", "badge", "advert", "advertisement", "sponsor",
        "newsletter", "subscribe", "cookie", "placeholder",
    )

    @classmethod
    def hero_source_is_usable(cls, source):
        if not cls.image_source_is_usable(source):
            return False
        lowered = source.strip().lower()
        return not any(token in lowered for token in cls.hero_rejected_tokens)

    @classmethod
    def image_value_sources(cls, value):
        if isinstance(value, str):
            yield value
        elif isinstance(value, list):
            for item in value:
                yield from cls.image_value_sources(item)
        elif isinstance(value, dict):
            for key in ("url", "contentUrl", "thumbnailUrl", "image"):
                if key in value:
                    yield from cls.image_value_sources(value[key])

    @classmethod
    def iter_json_ld_hero_sources(cls, soup):
        for script in soup.find_all("script"):
            script_type = (script.get("type") or "").split(";", 1)[0].strip().lower()
            if script_type != "application/ld+json":
                continue
            payload = script.string or script.get_text() or ""
            if not payload.strip():
                continue
            try:
                data = json.loads(payload)
            except (TypeError, ValueError):
                continue

            stack = list(data) if isinstance(data, list) else [data]
            while stack:
                node = stack.pop(0)
                if isinstance(node, list):
                    stack[0:0] = node
                    continue
                if not isinstance(node, dict):
                    continue

                node_type = node.get("@type")
                if isinstance(node_type, list):
                    types = {str(value).lower() for value in node_type}
                else:
                    types = {str(node_type).lower()} if node_type else set()
                article_like = not types or bool(
                    types
                    & {
                        "article",
                        "newsarticle",
                        "reportagenewsarticle",
                        "analysisnewsarticle",
                        "blogposting",
                    }
                )
                if article_like:
                    for key in ("image", "thumbnailUrl"):
                        for source in cls.image_value_sources(node.get(key)):
                            if cls.hero_source_is_usable(source):
                                yield source.strip()

                graph = node.get("@graph")
                if isinstance(graph, list):
                    stack.extend(graph)
                elif isinstance(graph, dict):
                    stack.append(graph)

    @classmethod
    def fallback_hero(cls, soup):
        meta_tags = soup.find_all("meta")
        for meta_name in cls.hero_meta_names:
            for meta in meta_tags:
                key = (meta.get("property") or meta.get("name") or "").strip().lower()
                itemprop = (meta.get("itemprop") or "").strip().lower()
                if key != meta_name and not (meta_name == "og:image" and itemprop in {"image", "thumbnailurl"}):
                    continue
                source = (meta.get("content") or "").strip()
                if cls.hero_source_is_usable(source):
                    alt = ""
                    for alt_meta in meta_tags:
                        alt_key = (alt_meta.get("property") or alt_meta.get("name") or "").strip().lower()
                        if alt_key in {"og:image:alt", "twitter:image:alt"}:
                            alt = (alt_meta.get("content") or "").strip()
                            if alt:
                                break
                    return source, alt, f"meta:{meta_name}"

        for link in soup.find_all("link"):
            rel = link.get("rel") or []
            if isinstance(rel, str):
                rel = rel.split()
            if "image_src" in {str(value).lower() for value in rel}:
                source = (link.get("href") or "").strip()
                if cls.hero_source_is_usable(source):
                    return source, "", "link:image_src"

        for source in cls.iter_json_ld_hero_sources(soup):
            return source, "", "json-ld:image"

        scopes = []
        for tag_name in ("article", "main"):
            scopes.extend(soup.find_all(tag_name))
        scopes.extend(
            element
            for element in soup.find_all(True)
            if str(element.get("role") or "").strip().lower() == "main"
        )
        if not scopes and soup.find("body") is not None:
            scopes.append(soup.find("body"))

        for scope in scopes:
            for image in scope.find_all("img"):
                source = (image.get("src") or "").strip()
                if cls.hero_source_is_usable(source):
                    return source, (image.get("alt") or "").strip(), "article-image"
        return "", "", ""

    @classmethod
    def inject_fallback_hero(cls, extracted_html, source_html):
        extracted = BeautifulSoup(extracted_html)
        cls.normalise_images(extracted)
        if extracted.find("img", src=True) is not None:
            return str(extracted), False, ""

        source_soup = BeautifulSoup(source_html)
        cls.normalise_images(source_soup)
        source, alt, origin = cls.fallback_hero(source_soup)
        if not source:
            return str(extracted), False, ""

        body = extracted.find("body")
        if body is None:
            return str(extracted), False, ""

        figure = extracted.new_tag("figure")
        image = extracted.new_tag("img")
        image["src"] = source
        if alt:
            image["alt"] = alt
        figure.append(image)

        heading = body.find(["h1", "h2"])
        if heading is not None:
            heading.insert_after(figure)
        else:
            body.insert(0, figure)
        return str(extracted), True, origin

    @classmethod
    def normalise_images(cls, soup):
        for fallback in list(soup.find_all("noscript")):
            nested = BeautifulSoup(fallback.decode_contents())
            image = nested.find("img")
            if image is not None:
                fallback.replaceWith(image)

        for image in list(soup.find_all("img")):
            width = image.get("width")
            height = image.get("height")
            try:
                if width and height and int(float(width)) <= 2 and int(float(height)) <= 2:
                    image.extract()
                    continue
            except ValueError:
                pass

            source = ""
            for srcset in (image.get("data-srcset"), image.get("srcset")):
                candidate = cls.best_srcset_source(srcset)
                if candidate:
                    source = candidate
                    break

            if not source:
                for attribute in (
                    "data-hi-res-src",
                    "data-full-src",
                    "data-original-src",
                    "data-original",
                    "data-lazy-src",
                    "data-image-src",
                    "data-flickity-lazyload",
                    "data-src",
                    "src",
                ):
                    candidate = image.get(attribute)
                    if cls.image_source_is_usable(candidate):
                        source = candidate.strip()
                        break

            if not source:
                picture = image.find_parent("picture")
                source_tags = picture.find_all("source") if picture is not None else []
                source_tags = sorted(
                    source_tags,
                    key=lambda tag: 1 if "avif" in (tag.get("type") or "").lower() else 0,
                )
                for source_tag in source_tags:
                    candidate = cls.best_srcset_source(
                        source_tag.get("data-srcset") or source_tag.get("srcset")
                    )
                    if candidate:
                        source = candidate
                        break

            if source:
                image["src"] = source
            else:
                image.extract()

    def preprocess_raw_html(self, raw_html, url):
        raw_html = self.invalid_xml_characters.sub("", raw_html)
        try:
            soup = BeautifulSoup(raw_html)
            self.normalise_images(soup)
            return str(soup)
        except Exception:
            self.log.exception(
                "Raw HTML image normalisation failed for "
                f"{self.url_for_log(url)}; continuing with unnormalised HTML"
            )
            return raw_html

    def extract_readable_article(self, html, url):
        extracted = super().extract_readable_article(html, url)
        try:
            extracted, injected, origin = self.inject_fallback_hero(extracted, html)
            if injected:
                self._fallback_hero_injections = getattr(self, "_fallback_hero_injections", 0) + 1
            return extracted
        except Exception:
            self.log.exception(
                "Hero-image fallback failed for "
                f"{self.url_for_log(url)}; continuing with readability output"
            )
            return extracted

    def preprocess_html(self, soup):
        self.normalise_images(soup)
        removable = [
            "script", "style", "noscript", "template", "iframe", "form", "button", "input",
            "canvas", "video", "audio", "object", "embed", "source", "svg",
        ]
        for element in list(soup.find_all(removable)):
            element.extract()

        global_allowed = {"id", "lang", "dir", "title"}
        tag_allowed = {
            "a": {"href"},
            "img": {"src", "alt"},
            "blockquote": {"cite"},
            "q": {"cite"},
            "td": {"colspan", "rowspan", "headers"},
            "th": {"colspan", "rowspan", "headers", "scope"},
            "ol": {"start"},
            "li": {"value"},
            "time": {"datetime"},
        }
        for element in soup.find_all(True):
            retained = global_allowed | tag_allowed.get(element.name, set())
            for attribute in list(element.attrs):
                if attribute not in retained:
                    del element[attribute]

            if element.name == "a" and element.get("href"):
                href = element.get("href").strip()
                if href.lower().startswith(self.unsafe_link_schemes):
                    del element["href"]

        return soup

    def postprocess_html(self, soup, first_fetch):
        removed_remote = 0
        for image in list(soup.find_all("img")):
            source = (image.get("src") or "").strip().lower()
            if not source or source.startswith(("http://", "https://", "//", "data:", "blob:", "file:")):
                image.extract()
                removed_remote += 1
        if removed_remote:
            self.log.warning(
                f"Removed {removed_remote} image references that were still remote or unusable after download processing"
            )

        if first_fetch:
            self._article_pages_seen = getattr(self, "_article_pages_seen", 0) + 1
            if soup.find("img", src=True) is not None:
                self._article_pages_with_images = getattr(self, "_article_pages_with_images", 0) + 1
        return soup

    def cleanup(self):
        seen = getattr(self, "_article_pages_seen", 0)
        with_images = getattr(self, "_article_pages_with_images", 0)
        injected = getattr(self, "_fallback_hero_injections", 0)
        if seen:
            percent = (with_images * 100.0) / seen
            message = (
                f"Article image coverage after download: {with_images}/{seen} "
                f"({percent:.1f}%) with at least one local image; "
                f"hero fallbacks injected={injected}"
            )
            if with_images * 2 < seen:
                self.log.warning(message)
            else:
                self.log.info(message)
        return super().cleanup()

    def populate_article_metadata(self, article, soup, first):
        if first:
            image = soup.find("img", src=True)
            if image is not None:
                self.add_toc_thumbnail(article, image.get("src"))
