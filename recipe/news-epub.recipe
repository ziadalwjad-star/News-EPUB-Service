    def __init__(self, options, log, progress_reporter):
        self.issue_date = datetime.now()
        self.publication_title = self.title
        requested_edition = os.environ.get("NEWS_EPUB_EDITION", "").strip().title()
        if requested_edition in {"Morning", "Evening", "Night"}:
            self.issue_name = requested_edition
        elif self.issue_date.hour < 12:
            self.issue_name = "Morning"
        elif self.issue_date.hour < 21:
            self.issue_name = "Evening"
        else:
            self.issue_name = "Night"
        self.title = self.issue_date.strftime(f"{self.publication_title} - %A, %d %B %Y - {self.issue_name} Edition")
        super().__init__(options, log, progress_reporter)

    def publication_date(self):
        return self.issue_date

    def get_masthead_title(self):
        return f"{self.publication_title} - {self.issue_name} Edition"

    def default_cover(self, cover_file):
        try:
            from calibre.ebooks.covers import cprefs, create_cover, override_prefs

            issue = self.issue_date.strftime(f"%A, %d %B %Y - {self.issue_name} Edition")
            preferences = override_prefs(cprefs, override_color_theme="Silver", override_style="Half and Half")
            cover_file.write(create_cover(self.publication_title, [issue], prefs=preferences))
            cover_file.flush()
        except Exception:
            self.log.exception("Failed to generate cover")
            return False
        return True

    def parse_feeds(self):
        original_feeds = self.feeds
        original_age = self.oldest_article
        specifications = [entry for group_name, entries in self.feed_groups for entry in entries]
        selected = specifications[:self.test[0]] if self.test else specifications
        parsed = []
        try:
            for source, section, url, days in selected:
                self.feeds = [(f"{source} — {section}", url)]
                self.oldest_article = days
                parsed.extend(super().parse_feeds())
        finally:
            self.feeds = original_feeds
            self.oldest_article = original_age
        return parsed

    def get_article_url(self, article):
        url = super().get_article_url(article)
        if url and ("abcnews.com/video/" in url or "cbsnews.com/video/" in url):
            return None
        return url

    @staticmethod
    def image_source_is_usable(source):
        if not source:
            return False
        source = source.strip()
        lowered = source.lower()
        if lowered.startswith(("data:", "blob:", "javascript:", "about:", "#")):
            return False
        rejected = ("1x1", "spacer", "transparent", "tracking", "pixel.gif", "clear.gif")
        return not any(value in lowered for value in rejected)

    @classmethod
    def best_srcset_source(cls, srcset):
        candidates = []
        for position, item in enumerate((srcset or "").split(",")):
            parts = item.strip().rsplit(None, 1)
            source = parts[0].strip() if parts else ""
            if not cls.image_source_is_usable(source):
                continue
            score = position + 1
            if len(parts) == 2:
                descriptor = parts[1].lower()
                try:
                    if descriptor.endswith("w"):
                        width = float(descriptor[:-1])
                        score = 1000000 - width if width >= 1264 else width
                    elif descriptor.endswith("x"):
                        density = float(descriptor[:-1])
                        score = min(density, 2.0) * 1000
                except ValueError:
                    pass
            candidates.append((score, source))
        return max(candidates, default=(0, ""))[1]

    @classmethod
    def normalise_images(cls, soup):
        for fallback in list(soup.find_all("noscript")):
            try:
                nested = BeautifulSoup(fallback.decode_contents())
                image = nested.find("img")
            except Exception:
                image = None
            if image is not None:
                fallback.replaceWith(image)

        for image in list(soup.find_all("img")):
            width = image.get("width")
            height = image.get("height")
            try:
                if width and height and int(float(width)) <= 2 and int(float(height)) <= 2:
                    image.extract()
                    continue
            except ValueError:
                pass

            source = ""
            for srcset in (image.get("data-srcset"), image.get("srcset")):
                candidate = cls.best_srcset_source(srcset)
                if candidate:
                    source = candidate
                    break

            if not source:
                for attribute in (
                    "data-hi-res-src",
                    "data-full-src",
                    "data-original-src",
                    "data-original",
                    "data-lazy-src",
                    "data-image-src",
                    "data-flickity-lazyload",
                    "data-src",
                    "src",
                ):
                    candidate = image.get(attribute)
                    if cls.image_source_is_usable(candidate):
                        source = candidate.strip()
                        break

            if not source:
                picture = image.find_parent("picture")
                source_tags = picture.find_all("source") if picture is not None else []
                source_tags = sorted(
                    source_tags,
                    key=lambda tag: 1 if "avif" in (tag.get("type") or "").lower() else 0,
                )
                for source_tag in source_tags:
                    candidate = cls.best_srcset_source(source_tag.get("data-srcset") or source_tag.get("srcset"))
                    if candidate:
                        source = candidate
                        break

            if source:
                image["src"] = source
            else:
                image.extract()

    def preprocess_raw_html(self, raw_html, url):
        raw_html = self.invalid_xml_characters.sub("", raw_html)
        try:
            soup = BeautifulSoup(raw_html)
            self.normalise_images(soup)
            return str(soup)
        except Exception:
            return raw_html

    def preprocess_html(self, soup):
        self.normalise_images(soup)
        removable = ["script", "style", "noscript", "template", "iframe", "form", "button", "input", "canvas", "video", "audio", "object", "embed", "source", "svg"]
        for element in list(soup.find_all(removable)):
            element.extract()
        allowed = {
            "a": {"href", "title"},
            "img": {"src", "alt", "title"},
            "td": {"colspan", "rowspan"},
            "th": {"colspan", "rowspan", "scope"},
            "ol": {"start"},
            "time": {"datetime"},
        }
        for element in soup.find_all(True):
            retained = allowed.get(element.name, set())
            for attribute in list(element.attrs):
                if attribute not in retained:
                    del element[attribute]
        return soup

    def postprocess_html(self, soup, first_fetch):
        for image in list(soup.find_all("img")):
            source = (image.get("src") or "").strip().lower()
            if not source or source.startswith(("http://", "https://", "//", "data:", "blob:")):
                image.extract()
        return soup

    def populate_article_metadata(self, article, soup, first):
        if first:
            image = soup.find("img", src=True)
            if image is not None:
                self.add_toc_thumbnail(article, image.get("src"))

    @staticmethod
    def element_classes(element):
        value = element.get("class") or []
        if isinstance(value, str):
            return value.split()
        return list(value)

    def tidy_generated_pages(self, directory):
        for root, directories, filenames in os.walk(directory):
            directories.sort()
            for filename in sorted(filenames):
                if not filename.lower().endswith((".html", ".xhtml")):
                    continue
                path = os.path.join(root, filename)
                try:
                    with open(path, "rb") as source:
                        soup = BeautifulSoup(source.read().decode("utf-8", "replace"))
                    body = soup.find("body")
                    if body is None:
                        continue
                    navbars = []
                    for element in body.find_all(True):
                        classes = self.element_classes(element)
                        if "calibre_navbar" in classes or "touchscreen_navbar" in classes:
                            navbars.append(element)
                    if navbars:
                        primary = navbars[0]
                        for duplicate in navbars[1:]:
                            duplicate.extract()
                        primary.extract()
                        body.insert(0, primary)
                    if os.path.abspath(path) == os.path.abspath(os.path.join(directory, "index.html")):
                        for paragraph in list(body.find_all(["p", "h3"])):
                            if not self.tag_to_string(paragraph, use_alt=False).strip() and paragraph.find("img") is None:
                                paragraph.extract()
                    with open(path, "wb") as destination:
                        destination.write(str(soup).encode("utf-8"))
                except Exception:
                    self.log.exception(f"Failed to tidy generated page: {path}")

    def create_opf(self, feeds, dir=None):
        directory = dir or self.output_dir
        super().create_opf(feeds, dir)
        self.tidy_generated_pages(directory)
