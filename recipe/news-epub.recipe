def env_int(name, default, minimum, maximum):
    raw = os.environ.get(name, "").strip()
    if not raw:
        return default
    try:
        value = int(raw)
    except ValueError as exc:
        raise ValueError(f"{name} must be an integer") from exc
    if value < minimum or value > maximum:
        raise ValueError(f"{name} must be between {minimum} and {maximum}")
    return value


class NewsEpubRecipe(BasicNewsRecipe):
    title = os.environ.get("NEWS_EPUB_TITLE", "News Digest").strip() or "News Digest"
    description = os.environ.get(
        "NEWS_EPUB_DESCRIPTION",
        "A curated news digest prepared for private offline reading.",
    ).strip()
    language = os.environ.get("NEWS_EPUB_LANGUAGE", "en").strip() or "en"
    publication_type = "newspaper"
    requires_version = (9, 0, 0)
    timefmt = ""
    oldest_article = 1
    max_articles_per_feed = env_int("NEWS_EPUB_MAX_ARTICLES_PER_FEED", 20, 1, 100)
    min_issue_articles = env_int("NEWS_EPUB_MIN_ARTICLES", 10, 1, 10000)
    source_image_target_width = env_int("NEWS_EPUB_IMAGE_TARGET_WIDTH", 1600, 600, 5000)
    remove_empty_feeds = True
    ignore_duplicate_articles = {"title", "url"}
    use_embedded_content = None
    auto_cleanup = True
    auto_cleanup_keep = (
        "//article//figure|//article//picture|//article//img|"
        "//main//figure|//main//picture|//main//img|"
        "//*[@role='main']//figure|//*[@role='main']//picture|//*[@role='main']//img"
    )
    remove_javascript = True
    no_stylesheets = True
    remove_attributes = ["style", "font", "onclick", "onload"]
    recursions = 0
    simultaneous_downloads = env_int("NEWS_EPUB_DOWNLOAD_WORKERS", 3, 1, 8)
    timeout = env_int("NEWS_EPUB_FETCH_TIMEOUT", 75, 10, 300)
    browser_type = "qt"
    handle_gzip = True
    compress_news_images = True
    scale_news_images_to_device = True
    center_navbar = True
    conversion_options = {"pretty_print": False}

