import os
import re
from datetime import datetime

from calibre.ebooks.BeautifulSoup import BeautifulSoup
from calibre.web.feeds.news import BasicNewsRecipe


class NewsEpubRecipe(BasicNewsRecipe):
    title = os.environ.get("NEWS_EPUB_TITLE", "News Digest").strip() or "News Digest"
    description = "A curated news digest prepared as an EPUB for scheduled offline reading."
    language = "en"
    publication_type = "newspaper"
    requires_version = (9, 0, 0)
    timefmt = ""
    oldest_article = 1
    max_articles_per_feed = 20
    remove_empty_feeds = True
    ignore_duplicate_articles = {"title", "url"}
    use_embedded_content = None
    auto_cleanup = True
    auto_cleanup_keep = "//article//figure|//article//picture|//main//figure|//main//picture"
    remove_javascript = True
    no_stylesheets = True
    remove_attributes = ["style", "font", "onclick", "onload"]
    recursions = 0
    simultaneous_downloads = 3
    timeout = 75
    browser_type = "qt"
    handle_gzip = True
    compress_news_images = True
    compress_news_images_max_size = 96
    scale_news_images_to_device = True
    center_navbar = True
    conversion_options = {
        "flow_size": 0,
        "pretty_print": False,
        "base_font_size": 16,
        "linearize_tables": True,
    }
    extra_css = """
