#!/usr/bin/env python3
from __future__ import annotations

import importlib.util
from importlib.machinery import SourceFileLoader
import os
from pathlib import Path
import sys
import zipfile

CORE_PATH = Path(__file__).with_name("news-epub-validate")


def load_core():
    loader = SourceFileLoader("news_epub_validate_core", os.fspath(CORE_PATH))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None or spec.loader is None:
        raise RuntimeError(f"cannot load validator core: {CORE_PATH}")
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
    return module


def detect_raster_media_type(data: bytes) -> str | None:
    if data.startswith((b"GIF87a", b"GIF89a")):
        return "image/gif"
    if data.startswith(b"\xff\xd8\xff"):
        return "image/jpeg"
    if data.startswith(b"\x89PNG\r\n\x1a\n"):
        return "image/png"
    if len(data) >= 12 and data[:4] == b"RIFF" and data[8:12] == b"WEBP":
        return "image/webp"
    return None


def main() -> int:
    core = load_core()
    checked_media_types = {"image/gif", "image/jpeg", "image/png", "image/webp"}

    def validate_image_signature(archive: zipfile.ZipFile, item) -> None:
        if item.media_type == "image/svg+xml" or item.media_type not in checked_media_types:
            return
        with archive.open(item.path) as stream:
            prefix = stream.read(32)
        detected = detect_raster_media_type(prefix)
        if detected is None:
            raise core.ValidationError(
                "image bytes are not a recognised safe raster format for declared media type "
                f"{item.media_type}: {item.path}"
            )
        if detected != item.media_type:
            print(
                "news-epub-validate: warning: Calibre raster media-type mismatch tolerated: "
                f"declared={item.media_type} detected={detected} path={item.path}",
                file=sys.stderr,
            )

    core.validate_image_signature = validate_image_signature
    return core.main()


if __name__ == "__main__":
    raise SystemExit(main())
