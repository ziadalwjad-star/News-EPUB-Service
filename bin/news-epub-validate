#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import posixpath
import re
import stat
import sys
import zipfile
from dataclasses import dataclass
from pathlib import PurePosixPath
from urllib.parse import unquote, urlsplit
import xml.etree.ElementTree as ET

EX_DATAERR = 65
DEFAULT_MAX_UNCOMPRESSED_MIB = 512
DEFAULT_MAX_MEMBER_MIB = 128
MAX_MARKUP_BYTES = 32 * 1024 * 1024
ALLOWED_HYPERLINK_SCHEMES = {"http", "https", "mailto", "tel"}
ALLOWED_COMPRESSION = {zipfile.ZIP_STORED, zipfile.ZIP_DEFLATED}
ACTIVE_TAGS = {"applet", "base", "embed", "form", "iframe", "object", "script"}
ACTIVE_MEDIA_TYPES = {
    "application/ecmascript",
    "application/javascript",
    "text/ecmascript",
    "text/javascript",
}
RESOURCE_ATTRS = {
    "audio": ("src",),
    "embed": ("src",),
    "iframe": ("src",),
    "img": ("src",),
    "input": ("src",),
    "object": ("data",),
    "source": ("src", "srcset"),
    "track": ("src",),
    "video": ("src", "poster"),
}
SVG_RESOURCE_TAGS = {"image", "use"}
CSS_URL_RE = re.compile(r"url\(\s*(['\"]?)(.*?)\1\s*\)", re.IGNORECASE | re.DOTALL)
CSS_IMPORT_RE = re.compile(
    r"@import\s+(?:url\(\s*)?(['\"]?)([^'\"\)\s;]+)\1\s*\)?",
    re.IGNORECASE,
)
DTD_RE = re.compile(br"<!\s*(?:DOCTYPE|ENTITY)\b", re.IGNORECASE)
EPUB_TYPE = "{http://www.idpf.org/2007/ops}type"
XML_BASE = "{http://www.w3.org/XML/1998/namespace}base"


class ValidationError(Exception):
    pass


@dataclass(frozen=True)
class ManifestItem:
    item_id: str
    path: str
    media_type: str
    properties: frozenset[str]


def local_name(name: str) -> str:
    return name.rsplit("}", 1)[-1].lower()


def mib_to_bytes(value: int) -> int:
    return value * 1024 * 1024


def safe_xml(data: bytes, label: str) -> ET.Element:
    if len(data) > MAX_MARKUP_BYTES:
        raise ValidationError(f"markup resource exceeds {MAX_MARKUP_BYTES // (1024 * 1024)} MiB: {label}")
    if DTD_RE.search(data):
        raise ValidationError(f"DTD/entity declarations are not allowed: {label}")
    try:
        return ET.fromstring(data)
    except ET.ParseError as exc:
        raise ValidationError(f"invalid XML/XHTML in {label}: {exc}") from exc


def ensure_safe_member_name(name: str) -> None:
    if not name:
        raise ValidationError("archive contains an empty member name")
    if "\\" in name:
        raise ValidationError(f"archive member uses backslash separators: {name}")
    if any(ord(char) < 32 or ord(char) == 127 for char in name):
        raise ValidationError(f"archive member contains control characters: {name!r}")
    path = PurePosixPath(name)
    if path.is_absolute() or ".." in path.parts:
        raise ValidationError(f"unsafe archive member path: {name}")


def normalise_archive_path(base: str, href: str) -> str:
    split = urlsplit(href)
    if split.scheme or split.netloc or href.startswith("//"):
        raise ValidationError(f"remote resource URL is not allowed: {href}")
    decoded_path = unquote(split.path)
    if not decoded_path:
        raise ValidationError(f"empty local resource path: {href}")
    combined = posixpath.normpath(posixpath.join(base, decoded_path))
    if combined == ".." or combined.startswith("../") or combined.startswith("/"):
        raise ValidationError(f"resource escapes the EPUB container: {href}")
    return combined


def parse_srcset(value: str) -> list[str]:
    urls = []
    for candidate in value.split(","):
        url = candidate.strip().split(None, 1)[0]
        if url:
            urls.append(url)
    return urls


def css_references(text: str) -> list[str]:
    refs = [match.group(2).strip() for match in CSS_URL_RE.finditer(text)]
    refs.extend(match.group(2).strip() for match in CSS_IMPORT_RE.finditer(text))
    return [ref for ref in refs if ref]


def iter_document_references(root: ET.Element):
    for element in root.iter():
        tag = local_name(element.tag)
        if tag in {"a", "area"}:
            href = element.attrib.get("href")
            if href:
                yield "hyperlink", href
        elif tag == "link":
            href = element.attrib.get("href")
            if href:
                yield "resource", href

        if tag in SVG_RESOURCE_TAGS:
            href = element.attrib.get("href") or element.attrib.get("{http://www.w3.org/1999/xlink}href")
            if href:
                yield "resource", href

        for attr in RESOURCE_ATTRS.get(tag, ()):
            value = element.attrib.get(attr)
            if not value:
                continue
            if attr == "srcset":
                for ref in parse_srcset(value):
                    yield "resource", ref
            else:
                yield "resource", value

        style = element.attrib.get("style")
        if style:
            for ref in css_references(style):
                yield "resource", ref

        if tag == "style" and element.text:
            for ref in css_references(element.text):
                yield "resource", ref


def validate_zip_info(info: zipfile.ZipInfo, max_member_bytes: int) -> None:
    ensure_safe_member_name(info.filename)
    if info.flag_bits & 0x1:
        raise ValidationError(f"encrypted ZIP members are not allowed: {info.filename}")
    if not info.is_dir() and info.compress_type not in ALLOWED_COMPRESSION:
        raise ValidationError(f"unsupported ZIP compression method for {info.filename}: {info.compress_type}")
    mode = (info.external_attr >> 16) & 0o170000
    if mode == stat.S_IFLNK:
        raise ValidationError(f"symbolic-link ZIP members are not allowed: {info.filename}")
    if info.file_size > max_member_bytes:
        raise ValidationError(
            f"archive member exceeds the configured {max_member_bytes // (1024 * 1024)} MiB limit: {info.filename}"
        )


def validate_required_metadata(package: ET.Element, version: str) -> None:
    titles = [e for e in package.iter() if local_name(e.tag) == "title" and (e.text or "").strip()]
    languages = [e for e in package.iter() if local_name(e.tag) == "language" and (e.text or "").strip()]
    identifiers = [e for e in package.iter() if local_name(e.tag) == "identifier" and (e.text or "").strip()]
    if not titles:
        raise ValidationError("package metadata has no non-empty title")
    if not languages:
        raise ValidationError("package metadata has no non-empty language")
    if not identifiers:
        raise ValidationError("package metadata has no non-empty identifier")

    unique_identifier = package.attrib.get("unique-identifier", "").strip()
    if unique_identifier and not any(e.attrib.get("id") == unique_identifier for e in identifiers):
        raise ValidationError(f"unique-identifier does not reference a dc:identifier: {unique_identifier}")

    if version.startswith("3"):
        modified = [
            e
            for e in package.iter()
            if local_name(e.tag) == "meta"
            and e.attrib.get("property", "").strip() == "dcterms:modified"
            and (e.text or "").strip()
        ]
        if not modified:
            raise ValidationError("EPUB 3 package metadata is missing dcterms:modified")


def validate_nav_document(root: ET.Element, path: str) -> None:
    toc_navs = []
    for element in root.iter():
        if local_name(element.tag) != "nav":
            continue
        epub_type = element.attrib.get(EPUB_TYPE, "")
        if "toc" in epub_type.split():
            toc_navs.append(element)
    if len(toc_navs) != 1:
        raise ValidationError(f"navigation document must contain exactly one epub:type='toc' nav: {path}")


def validate_image_signature(archive: zipfile.ZipFile, item: ManifestItem) -> None:
    if item.media_type == "image/svg+xml":
        return
    signatures = {
        "image/gif": lambda data: data.startswith((b"GIF87a", b"GIF89a")),
        "image/jpeg": lambda data: data.startswith(b"\xff\xd8\xff"),
        "image/png": lambda data: data.startswith(b"\x89PNG\r\n\x1a\n"),
        "image/webp": lambda data: len(data) >= 12 and data[:4] == b"RIFF" and data[8:12] == b"WEBP",
    }
    checker = signatures.get(item.media_type)
    if checker is None:
        return
    with archive.open(item.path) as stream:
        prefix = stream.read(16)
    if not checker(prefix):
        raise ValidationError(f"image bytes do not match declared media type {item.media_type}: {item.path}")


def audit_document(root: ET.Element, path: str) -> tuple[set[str], list[tuple[str, str]]]:
    ids: set[str] = set()
    for element in root.iter():
        tag = local_name(element.tag)
        if tag in ACTIVE_TAGS:
            raise ValidationError(f"active or unsafe element <{tag}> is not allowed: {path}")
        if XML_BASE in element.attrib:
            raise ValidationError(f"xml:base is not allowed because it changes resource resolution: {path}")
        for attr_name in element.attrib:
            attr = local_name(attr_name)
            if attr.startswith("on") and len(attr) > 2:
                raise ValidationError(f"event-handler attribute {attr!r} is not allowed: {path}")
        if tag == "meta" and element.attrib.get("http-equiv", "").strip().lower() == "refresh":
            raise ValidationError(f"meta refresh is not allowed: {path}")
        element_id = element.attrib.get("id")
        if element_id:
            if element_id in ids:
                raise ValidationError(f"duplicate id {element_id!r} in {path}")
            ids.add(element_id)
    return ids, list(iter_document_references(root))


def validate_reference(
    *,
    kind: str,
    source_path: str,
    href: str,
    manifest_paths: set[str],
    ids_by_doc: dict[str, set[str]],
) -> None:
    split = urlsplit(href)
    external = bool(split.scheme or split.netloc or href.startswith("//"))

    if kind == "resource" and external:
        raise ValidationError(f"external publication resource from {source_path}: {href}")
    if kind == "hyperlink" and split.scheme and split.scheme.lower() not in ALLOWED_HYPERLINK_SCHEMES:
        raise ValidationError(f"unsafe hyperlink scheme from {source_path}: {href}")
    if external:
        return

    if not split.path:
        target_doc = source_path
    else:
        target_doc = normalise_archive_path(posixpath.dirname(source_path), href)

    if target_doc not in manifest_paths:
        raise ValidationError(f"reference targets a resource absent from the manifest from {source_path}: {href}")

    if split.fragment:
        target_id = unquote(split.fragment)
        known_ids = ids_by_doc.get(target_doc)
        if known_ids is not None and target_id not in known_ids:
            raise ValidationError(f"missing fragment target from {source_path}: {href}")


def validate_css(
    text: str,
    *,
    source_path: str,
    manifest_paths: set[str],
) -> None:
    for href in css_references(text):
        if href.startswith("#"):
            continue
        split = urlsplit(href)
        if split.scheme or split.netloc or href.startswith("//"):
            raise ValidationError(f"external CSS resource/import from {source_path}: {href}")
        target = normalise_archive_path(posixpath.dirname(source_path), href)
        if target not in manifest_paths:
            raise ValidationError(f"CSS reference targets a resource absent from the manifest from {source_path}: {href}")


def validate_epub(
    path: str,
    *,
    require_epub3: bool,
    max_uncompressed_bytes: int,
    max_member_bytes: int,
) -> dict[str, int | str]:
    if not zipfile.is_zipfile(path):
        raise ValidationError("file is not a readable ZIP/EPUB container")

    with zipfile.ZipFile(path) as archive:
        infos = archive.infolist()
        if not infos:
            raise ValidationError("EPUB container is empty")

        member_names: set[str] = set()
        total_uncompressed = 0
        for info in infos:
            validate_zip_info(info, max_member_bytes)
            if info.filename in member_names:
                raise ValidationError(f"duplicate ZIP member name is not allowed: {info.filename}")
            member_names.add(info.filename)
            total_uncompressed += info.file_size
            if total_uncompressed > max_uncompressed_bytes:
                raise ValidationError(
                    f"EPUB uncompressed size exceeds the configured {max_uncompressed_bytes // (1024 * 1024)} MiB limit"
                )

        first = infos[0]
        if first.filename != "mimetype":
            raise ValidationError("mimetype must be the first archive member")
        if first.compress_type != zipfile.ZIP_STORED:
            raise ValidationError("mimetype must be stored without compression")
        if archive.read("mimetype") != b"application/epub+zip":
            raise ValidationError("mimetype has the wrong content")

        corrupt_member = archive.testzip()
        if corrupt_member is not None:
            raise ValidationError(f"EPUB contains a corrupt ZIP member: {corrupt_member}")

        names = {info.filename for info in infos if not info.is_dir()}
        if "META-INF/container.xml" not in names:
            raise ValidationError("META-INF/container.xml is missing")
        container = safe_xml(archive.read("META-INF/container.xml"), "META-INF/container.xml")
        rootfiles = [e for e in container.iter() if local_name(e.tag) == "rootfile"]
        if len(rootfiles) != 1:
            raise ValidationError("exactly one package rootfile is required")
        rootfile = rootfiles[0]
        if rootfile.attrib.get("media-type", "").strip() != "application/oebps-package+xml":
            raise ValidationError("package rootfile has the wrong media-type")
        opf_path = rootfile.attrib.get("full-path", "").strip()
        ensure_safe_member_name(opf_path)
        if not opf_path or opf_path not in names:
            raise ValidationError(f"package document is missing: {opf_path or '<empty>'}")

        package = safe_xml(archive.read(opf_path), opf_path)
        if local_name(package.tag) != "package":
            raise ValidationError(f"package root element is not <package>: {opf_path}")
        version = package.attrib.get("version", "").strip()
        if not version:
            raise ValidationError("package version is missing")
        if require_epub3 and not version.startswith("3"):
            raise ValidationError(f"EPUB 3 required, package version is {version}")
        validate_required_metadata(package, version)

        opf_dir = posixpath.dirname(opf_path)
        manifest: dict[str, ManifestItem] = {}
        manifest_paths: set[str] = set()
        nav_items: list[ManifestItem] = []
        for element in package.iter():
            if local_name(element.tag) != "item":
                continue
            item_id = element.attrib.get("id", "").strip()
            href = element.attrib.get("href", "").strip()
            media_type = element.attrib.get("media-type", "").strip().lower()
            properties = frozenset(element.attrib.get("properties", "").split())
            if not item_id or item_id in manifest:
                raise ValidationError(f"missing or duplicate manifest id: {item_id or '<empty>'}")
            if not href:
                raise ValidationError(f"manifest item has an empty href: {item_id}")
            href_parts = urlsplit(href)
            if href_parts.scheme or href_parts.netloc or href.startswith("//"):
                raise ValidationError(f"remote manifest resource is not allowed: {href}")
            if href_parts.fragment:
                raise ValidationError(f"manifest href must not contain a fragment: {href}")
            item_path = normalise_archive_path(opf_dir, href)
            if item_path in manifest_paths:
                raise ValidationError(f"duplicate manifest resource: {item_path}")
            if item_path not in names:
                raise ValidationError(f"manifest resource is missing: {item_path}")
            if not media_type:
                raise ValidationError(f"manifest item has no media-type: {item_id}")
            if media_type in ACTIVE_MEDIA_TYPES or "scripted" in properties:
                raise ValidationError(f"active/scripted content is not allowed: {item_path}")
            item = ManifestItem(item_id, item_path, media_type, properties)
            manifest[item_id] = item
            manifest_paths.add(item_path)
            if "nav" in properties:
                nav_items.append(item)

        if not manifest:
            raise ValidationError("manifest is empty")
        if version.startswith("3"):
            if len(nav_items) != 1:
                raise ValidationError("EPUB 3 requires exactly one navigation document")
            if nav_items[0].media_type != "application/xhtml+xml":
                raise ValidationError("EPUB 3 navigation document must use application/xhtml+xml")

        allowed_unmanifested = {"mimetype", opf_path}
        orphaned = sorted(
            name
            for name in names
            if name not in manifest_paths and name not in allowed_unmanifested and not name.startswith("META-INF/")
        )
        if orphaned:
            raise ValidationError(f"publication resource is not declared in the manifest: {orphaned[0]}")

        spine_ids: list[str] = []
        for element in package.iter():
            if local_name(element.tag) != "itemref":
                continue
            idref = element.attrib.get("idref", "").strip()
            if not idref or idref not in manifest:
                raise ValidationError(f"spine references missing manifest id: {idref or '<empty>'}")
            spine_ids.append(idref)
        if not spine_ids:
            raise ValidationError("spine is empty")

        xhtml_items = [item for item in manifest.values() if item.media_type == "application/xhtml+xml"]
        svg_items = [item for item in manifest.values() if item.media_type == "image/svg+xml"]
        css_items = [item for item in manifest.values() if item.media_type == "text/css"]
        image_items = [item for item in manifest.values() if item.media_type.startswith("image/")]

        ids_by_doc: dict[str, set[str]] = {}
        refs_by_doc: dict[str, list[tuple[str, str]]] = {}
        parsed_documents: dict[str, ET.Element] = {}

        for item in [*xhtml_items, *svg_items]:
            root = safe_xml(archive.read(item.path), item.path)
            expected_root = "html" if item.media_type == "application/xhtml+xml" else "svg"
            if local_name(root.tag) != expected_root:
                raise ValidationError(f"{item.media_type} resource has unexpected root element <{local_name(root.tag)}>: {item.path}")
            ids, refs = audit_document(root, item.path)
            ids_by_doc[item.path] = ids
            refs_by_doc[item.path] = refs
            parsed_documents[item.path] = root

        if nav_items:
            validate_nav_document(parsed_documents[nav_items[0].path], nav_items[0].path)

        for source_path, refs in refs_by_doc.items():
            for kind, href in refs:
                validate_reference(
                    kind=kind,
                    source_path=source_path,
                    href=href,
                    manifest_paths=manifest_paths,
                    ids_by_doc=ids_by_doc,
                )

        for item in css_items:
            data = archive.read(item.path)
            if len(data) > MAX_MARKUP_BYTES:
                raise ValidationError(f"stylesheet exceeds {MAX_MARKUP_BYTES // (1024 * 1024)} MiB: {item.path}")
            text = data.decode("utf-8", "replace")
            validate_css(text, source_path=item.path, manifest_paths=manifest_paths)

        for item in image_items:
            validate_image_signature(archive, item)

        return {
            "version": version,
            "manifest_items": len(manifest),
            "spine_items": len(spine_ids),
            "xhtml_items": len(xhtml_items),
            "image_items": len(image_items),
            "uncompressed_bytes": total_uncompressed,
        }


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Validate EPUB structure plus News EPUB local-first, inactive-content and integrity invariants."
    )
    parser.add_argument("epub", help="EPUB file to validate")
    parser.add_argument("--require-epub3", action="store_true", help="reject package versions older than EPUB 3")
    parser.add_argument(
        "--max-uncompressed-mib",
        type=int,
        default=DEFAULT_MAX_UNCOMPRESSED_MIB,
        metavar="MIB",
        help=f"maximum total uncompressed EPUB size (default: {DEFAULT_MAX_UNCOMPRESSED_MIB} MiB)",
    )
    parser.add_argument(
        "--max-member-mib",
        type=int,
        default=DEFAULT_MAX_MEMBER_MIB,
        metavar="MIB",
        help=f"maximum uncompressed size of one archive member (default: {DEFAULT_MAX_MEMBER_MIB} MiB)",
    )
    parser.add_argument("--json", action="store_true", help="emit validation metrics as JSON")
    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    if args.max_uncompressed_mib <= 0 or args.max_member_mib <= 0:
        parser.error("size limits must be greater than zero")

    try:
        metrics = validate_epub(
            args.epub,
            require_epub3=args.require_epub3,
            max_uncompressed_bytes=mib_to_bytes(args.max_uncompressed_mib),
            max_member_bytes=mib_to_bytes(args.max_member_mib),
        )
    except (OSError, RuntimeError, zipfile.BadZipFile, ValidationError) as exc:
        print(f"news-epub-validate: error: {exc}", file=sys.stderr)
        return EX_DATAERR

    if args.json:
        print(json.dumps(metrics, sort_keys=True, separators=(",", ":")))
    else:
        print(
            "news-epub-validate: ok: "
            f"version={metrics['version']} manifest_items={metrics['manifest_items']} "
            f"spine_items={metrics['spine_items']} xhtml_items={metrics['xhtml_items']} "
            f"image_items={metrics['image_items']} uncompressed_bytes={metrics['uncompressed_bytes']}"
        )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
