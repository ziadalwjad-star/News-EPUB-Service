# Core paths. NEWS_EPUB_WORK and NEWS_EPUB_OUTBOX are optional; when omitted
# they default to work/ and outbox/ beneath NEWS_EPUB_ROOT.
NEWS_EPUB_ROOT=/var/lib/news-epub
NEWS_EPUB_RECIPE=/opt/news-epub/news-epub.recipe
# Calibre can occasionally preserve a safe raster payload under a mismatched
# raster media-type/extension. The compatibility validator warns on that case
# but still rejects unrecognised bytes, active content and remote resources.
NEWS_EPUB_VALIDATOR=/usr/local/bin/news-epub-validate-calibre
NEWS_EPUB_EBOOK_CONVERT=ebook-convert
NEWS_EPUB_EPUBCHECK=

# Publication identity and filenames.
NEWS_EPUB_TITLE="News Digest"
NEWS_EPUB_DESCRIPTION="A curated news digest prepared for private offline reading."
NEWS_EPUB_LANGUAGE=en
NEWS_EPUB_FILENAME_PREFIX=news-epub

# Build and publication policy.
NEWS_EPUB_EPUB_VERSION=3
NEWS_EPUB_OUTPUT_PROFILE=
NEWS_EPUB_REQUIRE_EPUBCHECK=0
NEWS_EPUB_RETENTION_DAYS=7
NEWS_EPUB_MAX_ATTEMPTS=3
NEWS_EPUB_RETRY_DELAY=600
NEWS_EPUB_LOCK_WAIT=300
NEWS_EPUB_STALE_RUN_HOURS=24
NEWS_EPUB_UMASK=0027

# Local integrity limits for the finished EPUB.
NEWS_EPUB_MAX_UNCOMPRESSED_MIB=512
NEWS_EPUB_MAX_MEMBER_MIB=128

# Recipe limits. Invalid values fail explicitly during recipe loading.
NEWS_EPUB_MAX_ARTICLES_PER_FEED=20
NEWS_EPUB_MIN_ARTICLES=10
NEWS_EPUB_IMAGE_TARGET_WIDTH=1600
NEWS_EPUB_DOWNLOAD_WORKERS=3
NEWS_EPUB_FETCH_TIMEOUT=75
